{
  "name": "words-for-kids",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests next.config.ts playwright.config.ts vitest.config.mts eslint.config.mjs postcss.config.mjs --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "docs:check": "python3 scripts/validate_docs.py",
    "preview:design": "python3 -m http.server 4319 --bind 127.0.0.1 --directory docs",
    "perf:baseline": "node scripts/measure-ui.mjs",
    "perf:search": "node scripts/measure-local-search.mjs",
    "eval:images": "node scripts/ai-benchmark/render.mjs",
    "eval:ai": "python3 -B scripts/ai-benchmark/self_test.py",
    "prebuild": "node scripts/prepare-offline.mjs && node scripts/prepare-pwa.mjs",
    "predev": "node scripts/prepare-offline.mjs && node scripts/prepare-pwa.mjs",
    "test:sql": "sh scripts/test-cloud.sh",
    "speaking:spike": "node scripts/speaking/spike.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@noble/hashes": "2.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "cmu-pronouncing-dictionary": "3.0.0",
    "cn": "0.4.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.53.0",
    "next": "16.4.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
