{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "document": {
      "type": "object",
      "properties": {
        "titleSuggestion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "lessonDateSuggestion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "detectedLanguages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "en",
              "vi",
              "other"
            ]
          },
          "minItems": 0,
          "maxItems": 3
        },
        "quality": {
          "type": "string",
          "enum": [
            "clear",
            "partial",
            "unreadable"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "titleSuggestion",
        "lessonDateSuggestion",
        "detectedLanguages",
        "quality",
        "warnings"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "pageIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 0
          },
          "bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "confidenceLabel": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "pageIndex",
          "bbox",
          "confidenceLabel"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "surfaceText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "word",
              "phrase"
            ]
          },
          "caseMode": {
            "type": "string",
            "enum": [
              "fold",
              "exact"
            ]
          },
          "posSuggestion": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "maxItems": 20
          },
          "extractionReason": {
            "type": "string",
            "enum": [
              "explicit_word_list",
              "emphasized",
              "phrase",
              "all_words_mode"
            ]
          },
          "reviewRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "candidateId",
          "surfaceText",
          "kind",
          "caseMode",
          "posSuggestion",
          "evidenceIds",
          "extractionReason",
          "reviewRequired"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "textEn": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "translationVi": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "source"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "maxItems": 20
          },
          "reviewRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "candidateId",
          "textEn",
          "translationVi",
          "origin",
          "evidenceIds",
          "reviewRequired"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "displayPattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "labelVi": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "constraint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "exampleValue": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "name",
                "labelVi",
                "constraint",
                "exampleValue"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 10
          },
          "origin": {
            "type": "string",
            "enum": [
              "source",
              "inferred"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "maxItems": 20
          },
          "reviewRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "candidateId",
          "displayPattern",
          "slots",
          "origin",
          "evidenceIds",
          "reviewRequired"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 50
    },
    "grammar": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "titleEn": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "titleVi": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "ruleKeySuggestion": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "source",
              "inferred"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "maxItems": 20
          },
          "reviewRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "candidateId",
          "titleEn",
          "titleVi",
          "ruleKeySuggestion",
          "origin",
          "evidenceIds",
          "reviewRequired"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 50
    }
  },
  "required": [
    "schemaVersion",
    "document",
    "evidence",
    "vocabulary",
    "sentences",
    "patterns",
    "grammar"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Words for Kids extraction v1"
}
