# REQUIRED for local. Copy into .env.local; restart after editing.
# App address you open; no /today or trailing slash.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4317
# false = your child's empty library; true = separate sample library.
APP_DEMO_MODE=false
# App SERVER AI gateway stays off. Parent BYOK is configured IN THE APP.
AI_PROVIDER=none

# OPTIONAL Google/cloud only. Leave empty to use local learning + dictionary + BYOK.
# Supabase project -> Connect / Settings -> Data API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase -> Settings -> API Keys -> Publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY: API Keys -> Secret keys (sb_secret_...), for account cleanup.
SUPABASE_SECRET_KEY=
# Legacy alternative to the secret above; use ONE, not both.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL additional Commons image search. Built-in licensed pictures need no env.
# Requires parent Google login and database migrations 0001-0006.
MEDIA_COMMONS_ENABLED=false
# Generate with node:crypto randomBytes(32).toString('base64url'); keep stable.
MEDIA_IMPORT_SIGNING_SECRET=

# Do not put a parent Gemini key here. Settings -> Parent AI -> API key.
# Full click-by-click instructions and callbacks: SETUP-PROJECT.md.
